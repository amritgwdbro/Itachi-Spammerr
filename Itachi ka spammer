-- ===== RP NAME & BIO SETTER ON EXECUTE =====
local function setItachiRP()
	pcall(function()
		local reFolder = ReplicatedStorage:FindFirstChild("RE")
		if reFolder then
			for _, rem in ipairs(reFolder:GetChildren()) do
				if rem:IsA("RemoteEvent") then
					local lower = rem.Name:lower()
					if lower:find("rpname") or lower:find("name") then
						pcall(function() rem:FireServer("RolePlayName", RP_NAME) end)
						pcall(function() rem:FireServer(RP_NAME) end)
					elseif lower:find("rpbio") or lower:find("bio") then
						pcall(function() rem:FireServer("RolePlayBio", RP_BIO) end)
						pcall(function() rem:FireServer(RP_BIO) end)
					end
				end
			end
		end

		for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
			if desc:IsA("RemoteEvent") then
				local n = desc.Name:lower()
				if n:find("rpname") or n:find("setname") then
					pcall(function() desc:FireServer(RP_NAME) end)
				elseif n:find("rpbio") or n:find("setbio") then
					pcall(function() desc:FireServer(RP_BIO) end)
				end
			end
		end
	end)
end

-- ===== CHAT SEND =====
local function sendChat(msg)
	if not msg or msg == "" then return end
	pcall(function()
		local channels = TextChatService:FindFirstChild("TextChannels")
		local general = channels and channels:FindFirstChild("RBXGeneral")
		if general and general.SendAsync then
			general:SendAsync(msg)
			return
		end
	end)
	pcall(function()
		local legacy = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
			and ReplicatedStorage.DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")
		if legacy then
			legacy:FireServer(msg, "All")
		end
	end)
end

-- ===== GET ACTIVE TARGETS FROM 4 BOXES =====
local function getActiveTargets()
	local list = {}
	for _, box in ipairs({target1, target2, target3, target4}) do
		local cleaned = box.Text:match("^%s*(.-)%s*$")
		if cleaned and cleaned ~= "" then
			table.insert(list, cleaned)
		end
	end
	if #list == 0 then
		table.insert(list, "[TARGET]")
	end
	return list
end

-- ===== BUILD MESSAGE =====
local presetIdx = 1
local targetIdx = 1

local function buildMessage()
	local rawCount = tonumber(countBox.Text) or 100
	local count = math.clamp(math.floor(rawCount), 1, 500)
	local prefix = string.rep("@", count)

	local pool = (mode == "ROAST") and presetsRoast or presetsAt
	local line = pool[presetIdx] or pool[1]
	presetIdx = presetIdx + 1
	if presetIdx > #pool then
		presetIdx = 1
	end

	local targets = getActiveTargets()
	local chosenTarget = targets[targetIdx] or targets[1]
	targetIdx = targetIdx + 1
	if targetIdx > #targets then
		targetIdx = 1
	end

	local formatted = line:gsub("%[TARGET%]", chosenTarget):gsub("%[Target%]", chosenTarget)
	return prefix .. formatted
end

-- ===== START & STOP LOGIC =====
startBtn.MouseButton1Click:Connect(function()
	if running then return end
	running = true
	startBtn.BackgroundColor3 = Color3.fromRGB(190, 20, 35)
	stopBtn.BackgroundColor3 = DARK_RED.stopBtn
	statusLbl.Text = "Status: Running (" .. mode .. ")..."
	statusLbl.TextColor3 = DARK_RED.brightRed

	task.spawn(function()
		while running do
			sendChat(buildMessage())

			local rawDelay = tonumber(delayBox.Text)
			local waitTime = rawDelay and math.clamp(rawDelay, 0.1, 10) or 1.1

			local elapsed = 0
			while running and elapsed < waitTime do
				task.wait(0.05)
				elapsed += 0.05
			end
		end
	end)
end)

stopBtn.MouseButton1Click:Connect(function()
	running = false
	startBtn.BackgroundColor3 = DARK_RED.activeBtn
	stopBtn.BackgroundColor3 = Color3.fromRGB(190, 20, 35)
	statusLbl.Text = "Status: Stopped"
	statusLbl.TextColor3 = DARK_RED.subText
end)

